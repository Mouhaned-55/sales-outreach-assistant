# Optional shell environment override; .env files are not loaded automatically.
# Relative paths are resolved under backend/.
OUTREACH_DB_PATH=data/outreach.sqlite3

# Staged CSV/TSV source limits. Original bytes remain in SQLite.
# File size: 1 through 67108864 bytes; preview: 1 through 1000 rows.
OUTREACH_UPLOAD_MAX_BYTES=1048576
OUTREACH_UPLOAD_PREVIEW_ROWS=50
